{
  "name": "car-dealership-backend",
  "version": "1.0.0",
  "description": "Incubyte TDD Kata - Car Dealership Inventory System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test scripts/test-environment.test.cjs && jest --runInBand",
    "test:coverage": "node --test scripts/test-environment.test.cjs && jest --runInBand --coverage",
    "test:safety": "node --test scripts/test-environment.test.cjs",
    "test:database": "node scripts/check-test-database.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "tdd",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "incubyte"
  ],
  "author": "Shah",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.3"
  }
}
